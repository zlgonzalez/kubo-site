# Force HTTPS and WWW
RewriteEngine On 
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?kubomontessori\.com
RewriteRule ^(.*)$ https://www.kubomontessori.com/$1 [R,L]

# 301 Redirects to preserve search equity
Redirect 301 /rw /redwood-city-preschool-center/
Redirect 301 /rw/ /redwood-city-preschool-center/
Redirect 301 /homedaycare /san-mateo-preschool-daycare/
Redirect 301 /homedaycare/ /san-mateo-preschool-daycare/

# Security & Privacy Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
