---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  faqs?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    question: "Does Kubo Montessori require children to be potty trained before enrolling?",
    answer: "No, potty training is not required for enrollment at either campus. Our credentialed Montessori guides provide gentle, nurturing potty-training support tailored to each child's individual readiness and developmental phase.",
  },
  {
    question: "What are the student-to-teacher ratios at Kubo Montessori?",
    answer: "Our San Mateo campus operates at a low 12:2 ratio (6:1 effective ratio) in a home-based Casa dei Bambini setting, while our Redwood City campus operates at a 6:1 ratio in a licensed center environment.",
  },
  {
    question: "How does a mixed-age classroom benefit my child?",
    answer: "Mixed-age classrooms (20 months to 6 years) allow younger children to learn from older peers while older children deepen their understanding and leadership by guiding younger classmates. This builds strong empathy, social collaboration, and self-confidence.",
  },
  {
    question: "What daily meal options are provided?",
    answer: "Our San Mateo campus serves hot, organic lunches and healthy daily snacks cooked fresh in-house every morning. Our Redwood City campus provides nutritious organic morning and afternoon snacks.",
  },
  {
    question: "What is the enrollment process and waitlist timeline?",
    answer: "The first step is scheduling a private campus tour via our online Calendly link. After visiting, parents submit an application. Spaces are offered on a rolling basis, and we recommend reaching out early to secure preferred start dates.",
  },
];

const {
  title = "Frequently Asked Questions",
  subtitle = "Answers to common parent questions about our Montessori programs, ratios, and policies.",
  faqs = defaultFaqs,
} = Astro.props;

const faqSchemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section class="my-12">
  <div class="text-center max-w-2xl mx-auto mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{title}</h2>
    <p class="text-sm md:text-base text-slate-600 mt-2">{subtitle}</p>
  </div>

  <div class="max-w-3xl mx-auto space-y-4">
    {
      faqs.map((faq) => (
        <details class="group bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden transition-all duration-200 hover:border-slate-300">
          <summary class="flex justify-between items-center p-5 font-semibold text-slate-900 cursor-pointer select-none hover:bg-slate-50 list-none">
            <span class="pr-4 text-base md:text-lg">{faq.question}</span>
            <span class="transform transition-transform duration-200 group-open:rotate-180 text-amber-700 font-bold text-xl">
              ↓
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-slate-600 text-sm md:text-base leading-relaxed border-t border-slate-100">
            {faq.answer}
          </div>
        </details>
      ))
    }
  </div>

  <!-- FAQPage JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />
</section>
