---
interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  targetCity?: string;
  keywords?: string;
}

const {
  title,
  description = "Authentic Montessori Preschool & Daycare in San Mateo and Redwood City serving Bay Area Peninsula families.",
  image = "/images/kubo1.jpg",
  article = false,
  targetCity,
  keywords = "kubo, montessori preschool, daycare san mateo, daycare redwood city, foster city preschool, belmont ca daycare, san carlos montessori, burlingame preschool, menlo park daycare, early childhood education, Casa dei Bambini, Roots N Wings Montessori",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || Astro.url.origin,
);
const socialImageURL = new URL(image, Astro.url);
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;

const allServedCities = [
  "San Mateo",
  "Redwood City",
  "Foster City",
  "Belmont",
  "San Carlos",
  "Burlingame",
  "Menlo Park",
  "Woodside",
  "Hillsdale",
];

if (targetCity && !allServedCities.includes(targetCity)) {
  allServedCities.push(targetCity);
}

const multiEntitySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${siteOrigin}/#organization`,
      name: "Kubo Montessori",
      url: siteOrigin,
      logo: `${siteOrigin}/images/logo.png`,
      image: socialImageURL.toString(),
      description: description,
      telephone: "+1-408-502-6198",
      foundingDate: "2006",
      founder: {
        "@type": "Person",
        name: "Mary Gonzalez",
        jobTitle: "Founder & Educational Director",
      },
      sameAs: [
        "https://amshq.org/schools/roots-n-wings-montessori-by-kubo-montessori-llc-128193/",
        "https://www.facebook.com/kubomontessori",
        "https://www.instagram.com/kubomontessori",
      ],
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "5.0",
        reviewCount: "25",
      },
      areaServed: allServedCities,
    },
    {
      "@type": ["DayCare", "Preschool"],
      "@id": `${siteOrigin}/san-mateo-preschool-daycare#campus`,
      name: "Kubo Montessori - San Mateo Campus (Casa dei Bambini)",
      parentOrganization: {
        "@id": `${siteOrigin}/#organization`,
      },
      url: `${siteOrigin}/san-mateo-preschool-daycare/`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "2823 Flores St",
        addressLocality: "San Mateo",
        addressRegion: "CA",
        postalCode: "94403",
        addressCountry: "US",
      },
      telephone: "+1-650-430-4118",
      geo: {
        "@type": "GeoCoordinates",
        latitude: 37.54035,
        longitude: -122.304768,
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "17:30",
        },
      ],
      amenityFeature: [
        {
          "@type": "LocationFeatureSpecification",
          name: "Fresh Cooked Hot Organic Lunch",
          value: true,
        },
        {
          "@type": "LocationFeatureSpecification",
          name: "Potty Training Assistance",
          value: true,
        },
      ],
      areaServed: ["San Mateo", "Foster City", "Belmont", "Hillsdale", "Burlingame"],
    },
    {
      "@type": ["Preschool", "ChildCare"],
      "@id": `${siteOrigin}/redwood-city-preschool-center#campus`,
      name: "Roots N' Wings Montessori by Kubo Montessori LLC",
      parentOrganization: {
        "@id": `${siteOrigin}/#organization`,
      },
      url: `${siteOrigin}/redwood-city-preschool-center/`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "2323 Euclid Ave",
        addressLocality: "Redwood City",
        addressRegion: "CA",
        postalCode: "94061",
        addressCountry: "US",
      },
      telephone: "+1-408-502-6198",
      geo: {
        "@type": "GeoCoordinates",
        latitude: 37.463372,
        longitude: -122.20377,
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "08:30",
          closes: "17:30",
        },
      ],
      amenityFeature: [
        {
          "@type": "LocationFeatureSpecification",
          name: "Potty Training Assistance",
          value: true,
        },
        {
          "@type": "LocationFeatureSpecification",
          name: "Transitional Kindergarten (TK) Program",
          value: true,
        },
      ],
      areaServed: ["Redwood City", "San Carlos", "Menlo Park", "Woodside", "Atherton"],
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="keywords" content={keywords} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
  media="print"
  onload="this.media='all'"
/>

<!-- Multi-Entity JSON-LD Structured Data Schema -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(multiEntitySchema)}
/>
