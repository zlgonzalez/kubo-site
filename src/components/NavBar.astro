---
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  {
    href: "/services/",
    label: "Our Programs",
    dropdown: [
      { href: "/redwood-city-preschool-center/", label: "Roots N' Wings Montessori School" },
      { href: "/san-mateo-preschool-daycare/", label: "Montessori Home Daycare" },
    ],
  },
  {
    href: "/services/",
    label: "Locations Served",
    dropdown: [
      { href: "/san-mateo-preschool-daycare/", label: "San Mateo" },
      { href: "/redwood-city-preschool-center/", label: "Redwood City" },
      { href: "/foster-city-preschool-daycare/", label: "Foster City" },
      { href: "/belmont-ca-montessori-daycare/", label: "Belmont" },
      { href: "/san-carlos-montessori-preschool/", label: "San Carlos" },
      { href: "/burlingame-montessori-preschool/", label: "Burlingame" },
      { href: "/menlo-park-montessori-preschool/", label: "Menlo Park" },
    ],
  },
  {
    href: "/resources/montessori-vs-traditional-preschool/",
    label: "Resources",
    dropdown: [
      { href: "/resources/parent-handbook/", label: "Parent Handbook" },
      { href: "/resources/montessori-vs-traditional-preschool/", label: "Montessori vs. Traditional" },
      { href: "/resources/potty-training-preschool-guide/", label: "Potty Training Policy" },
      { href: "/resources/home-vs-center-childcare/", label: "Home vs. Center Daycare" },
    ],
  },
  { href: "/blog/", label: "Blog" },
  {
    href: "https://schools.mybrightwheel.com/sign-in",
    label: "Brightwheel",
    external: true,
  },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-dark text-white">
  <nav
    class="container mx-auto px-4 py-4 flex flex-wrap items-center justify-between"
  >
    <a href="/" class="text-xl font-bold flex items-center gap-2">
      <img
        src="/images/kubo-logo.jpeg"
        alt="Kubo Logo"
        class="h-10 w-auto"
        width="1773"
        height="2048"
      />
      <span>Kubo Montessori</span>
    </a>

    <button
      id="mobile-menu-toggle"
      class="lg:hidden block text-white focus:outline-none"
      aria-label="Toggle navigation"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div
      id="nav-content"
      class="hidden w-full lg:flex lg:w-auto lg:items-center mt-4 lg:mt-0"
    >
      <ul class="flex flex-col lg:flex-row lg:space-x-6">
        {
          links.map((link) => (
            <li class="relative group">
              <a
                href={link.href}
                class={`block py-2 lg:py-0 hover:text-amber-300 transition-colors ${currentPath === link.href ? "text-amber-400 font-semibold" : ""}`}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.label}
              </a>
              {link.dropdown && (
                <div class="hidden group-hover:block lg:absolute lg:top-full lg:left-0 lg:pt-2 z-50">
                  <div class="bg-transparent lg:bg-white text-white lg:text-gray-900 lg:shadow-xl lg:py-2 lg:rounded-lg lg:border lg:border-gray-100">
                    {link.dropdown.map((sublink) => (
                      <a
                        href={sublink.href}
                        class="block px-4 py-2 text-sm hover:bg-gray-700 lg:hover:bg-amber-50 lg:hover:text-amber-950 whitespace-nowrap"
                      >
                        {sublink.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const navContent = document.getElementById("nav-content");

  if (toggle && navContent) {
    toggle.addEventListener("click", () => {
      navContent.classList.toggle("hidden");
    });
  }
</script>
