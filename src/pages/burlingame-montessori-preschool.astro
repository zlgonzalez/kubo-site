---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import QuickFactTable from "../components/QuickFactTable.astro";
import FAQSection from "../components/FAQSection.astro";

const burlingameFaqs = [
  {
    question: "How close is Kubo Montessori to Burlingame, CA?",
    answer: "Kubo Montessori's San Mateo campus on Flores St is located just 10 to 12 minutes south of Burlingame via US-101 S or El Camino Real.",
  },
  {
    question: "What makes Kubo Montessori unique for Burlingame parents?",
    answer: "Burlingame parents choose Kubo Montessori for our authentic home-based Casa dei Bambini environment, low 12:2 student-to-teacher ratio, daily hot organic lunches cooked fresh on-site, and full potty-training assistance.",
  },
];
---

<Layout
  title="Montessori Preschool & Daycare in Burlingame, CA | Kubo Montessori"
  description="Looking for a top-rated Montessori preschool near Burlingame? Kubo Montessori in San Mateo offers screen-free learning, 6:1 ratios, hot organic lunches, and potty training support just 10 minutes south."
  image="/images/km1.jpg"
  targetCity="Burlingame"
>
  <NavBar />

  <!-- Hero Banner -->
  <div class="relative h-[380px] bg-gradient-to-r from-slate-950 via-slate-900 to-amber-950 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-25 mix-blend-overlay">
      <img src="/images/km1.jpg" alt="Montessori classroom serving Burlingame families" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-6xl mx-auto px-4 h-full flex flex-col items-center justify-center text-center">
      <span class="inline-block px-3.5 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
        Burlingame Childcare Guide
      </span>
      <h1 class="text-3xl md:text-5xl font-bold drop-shadow-md mb-4">
        Montessori Preschool & Daycare Serving Burlingame
      </h1>
      <p class="text-base md:text-lg text-slate-300 max-w-2xl">
        Located just 10 minutes south in San Mateo! Nurturing Casa dei Bambini program with low ratios, hot organic lunches, and potty training support.
      </p>
      <div class="mt-6 flex flex-wrap gap-4 justify-center">
        <a
          href="https://calendly.com/mary-kubo"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition-all text-sm"
        >
          Schedule a Private Campus Tour
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <!-- Commute Highlight -->
      <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200/80 mb-12 flex flex-col md:flex-row items-center gap-6">
        <div class="bg-slate-900 text-amber-400 p-4 rounded-xl text-center min-w-[140px] shadow-sm">
          <span class="text-3xl font-black block">10-12</span>
          <span class="text-xs uppercase font-medium tracking-wide text-slate-300">Minutes Drive</span>
        </div>
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Easy Commute from Burlingame</h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Located at <strong>2823 Flores St, San Mateo</strong>, our campus is a quick drive south on US-101 or El Camino Real. Burlingame families love our quiet residential neighborhood setting and dedicated parent parking.
          </p>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-slate-900 mb-4">Authentic Casa dei Bambini for Burlingame Toddlers & Preschoolers</h2>
      <p class="text-slate-600 leading-relaxed mb-6">
        Our San Mateo campus provides classic Montessori materials, uninterrupted 3-hour work cycles, and a warm home environment that bridges the transition from home care to formal school.
      </p>

      <!-- Quick Fact Table -->
      <QuickFactTable
        title="Burlingame Family Comparison Guide"
        subtitle="Key program metrics for Burlingame parents considering Kubo Montessori."
        highlightCampus="san-mateo"
      />

      <!-- Map & Driving Directions -->
      <div class="my-14 bg-slate-50 p-8 rounded-2xl border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Driving Routes from Burlingame</h2>
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <p class="text-slate-600 text-sm leading-relaxed mb-3">
              <strong>Via El Camino Real South:</strong> Drive South ~4 miles through downtown San Mateo, turn left on Flores St (2823 Flores St).
            </p>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              <strong>Via US-101 South:</strong> Take US-101 S to CA-92 W, exit Hillsdale Blvd / El Camino Real, and turn onto Flores St.
            </p>
            <a
              href="https://calendly.com/mary-kubo"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors"
            >
              Book Your Tour Today
            </a>
          </div>
          <div class="h-64 rounded-xl overflow-hidden shadow-sm border border-slate-200">
            <iframe
              src="https://maps.google.com/maps?q=2823+Flores+St+San+Mateo,+CA+94403&t=&z=14&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              title="Map from Burlingame to Kubo Montessori San Mateo"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <FAQSection
        title="Burlingame Parents FAQ"
        subtitle="Frequently asked questions for Burlingame families."
        faqs={burlingameFaqs}
      />
    </div>
  </div>

  <Footer />
</Layout>
