---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const images = [
  { src: "/images/baking-1.jpeg", alt: "Preschool children measuring and mixing ingredients in Montessori baking class" },
  { src: "/images/baking-2.jpeg", alt: "Montessori students kneading dough and developing fine motor skills" },
  { src: "/images/baking-3.jpeg", alt: "Children collaborating on measuring cups and sensory baking exploration" },
  { src: "/images/baking-4.jpeg", alt: "Preschoolers carefully shaping dough during hands-on culinary work cycle" },
  { src: "/images/baking-5.jpeg", alt: "Montessori students proudly displaying freshly baked items at Roots N' Wings" },
];
---

<Layout
  title="Baking - Roots N' Wings"
  description="Baking at Roots N Wings Montessori combines practical life skills with sensory exploration. Children learn measuring, sequencing, and independence."
  image="/images/baking-1.jpeg"
>
  <NavBar />

  <!-- Hero Section -->
  <div
    class="relative bg-cover bg-center h-[400px]"
    style="background-image: url('/images/image6.jpg');"
  >
    <div class="absolute inset-0 bg-black opacity-50"></div>
    <div
      class="relative max-w-7xl mx-auto px-4 h-full flex flex-col items-center justify-center text-center text-white"
    >
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Roots N' Wings Montessori School
      </h1>
      <p class="text-lg">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-3">/</span>
        <a href="/services/" class="hover:underline">Programs</a>
        <span class="mx-3">/</span>
        <a href="/redwood-city-preschool-center/" class="hover:underline">Roots N' Wings</a>
        <span class="mx-3">/</span>
        Baking
      </p>
    </div>
  </div>

  <!-- Content -->
  <div class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h2 class="text-3xl font-bold mb-6 text-gray-800">As Easy as Pie: Practical Life Culinary Skills</h2>
      <p class="text-gray-600 mb-6 leading-relaxed text-left">
        Baking aligns beautifully with the Montessori philosophy as it
        encourages hands-on learning, independence, and practical life skills.
        Through baking, children engage in rich sensory exploration, measuring, and
        sequencing, all while developing fine motor coordination and concentration. It
        fosters real-world independence as toddlers and preschoolers follow step-by-step
        recipes and take immense pride in creating nourishing foods to share with classmates.
      </p>
      <p class="text-gray-600 mb-6 leading-relaxed text-left">
        In our prepared kitchen environment at Roots N' Wings, children work with child-sized utensils,
        whisks, and measuring spoons. They discover foundational mathematical and scientific concepts—such
        as liquid vs. dry volume, state transitions through heat, and precise counting—long before encountering
        formal worksheets. Each session concludes with care of the environment: wiping tables, washing tools,
        and setting up clean trays for the next child.
      </p>
    </div>
  </div>

  <!-- Carousel (Grid) -->
  <div class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-12 text-center text-gray-800">
        Our Sweetie Pies in Action
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          images.map((img) => (
            <div class="h-64 overflow-hidden rounded shadow-lg">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <Footer />
</Layout>
