---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import Footer from "../../components/Footer.astro";
import QuickFactTable from "../../components/QuickFactTable.astro";
import FAQSection from "../../components/FAQSection.astro";

const pottyFaqs = [
  {
    question: "Do I need to potty train my toddler before enrolling at Kubo Montessori?",
    answer: "No! Unlike many Peninsula preschools that enforce strict potty-training prerequisites for 2- or 3-year-olds, Kubo Montessori does not require children to be potty trained before starting. Our credentialed guides partner with parents to provide active, supportive toilet learning.",
  },
  {
    question: "How does Montessori toilet learning work in the classroom?",
    answer: "In a Montessori environment, toilet learning is treated as a natural practical life skill rather than a source of stress or reward-chart pressure. Classrooms feature child-sized bathrooms, independence-friendly clothing setups, and routine bathroom visits incorporated into daily work cycles.",
  },
];
---

<Layout
  title="Preschool Without Potty Training Guide | Kubo Montessori"
  description="Stressed about preschool potty training deadlines? Discover Kubo Montessori's collaborative toilet-learning approach in San Mateo & Redwood City. Potty training support included for toddlers & preschoolers."
  image="/images/km2.jpg"
  article={true}
>
  <NavBar />

  <!-- Hero Banner -->
  <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-amber-950 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
        Parent Resource Guide
      </span>
      <h1 class="text-3xl md:text-5xl font-bold mb-4 drop-shadow-sm leading-tight">
        Preschool Without Potty Training Requirement: A Guide for Peninsula Parents
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto">
        How gentle, collaborative toilet learning at Kubo Montessori eliminates preschool enrollment anxiety for Bay Area families.
      </p>
    </div>
  </div>

  <!-- Content -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-3xl text-slate-700 leading-relaxed text-base space-y-8">
      <p class="text-lg text-slate-800 font-medium leading-relaxed">
        One of the most common anxieties for parents searching for toddler and preschool care across San Mateo, Foster City, Belmont, and Redwood City is the rigid <strong>potty training prerequisite</strong> enforced by traditional programs. Many centers require 2- and 3-year-old children to be 100% toilet-trained before their first day.
      </p>

      <h2 class="text-2xl font-bold text-slate-900 pt-4 border-t border-slate-100">The Kubo Montessori Approach: No Prerequisite Required</h2>
      <p>
        At Kubo Montessori, we believe toilet learning is a natural physical milestone, not an admission barrier. Both our <strong>San Mateo campus (Casa dei Bambini)</strong> and <strong>Redwood City campus (Roots N' Wings)</strong> welcome children who are still in diapers or pull-ups.
      </p>
      <p>
        Our credentialed guides partner directly with parents to establish a consistent, low-stress routine. By maintaining exceptionally low student-to-teacher ratios (6:1), our staff provide the individual attention required to support each child's independence.
      </p>

      <!-- Quick Fact Table -->
      <QuickFactTable
        title="Campus Potty Training Policies & Ratios"
        subtitle="Compare Kubo Montessori's supportive toilet-learning environment."
      />

      <h2 class="text-2xl font-bold text-slate-900 pt-4 border-t border-slate-100">How Montessori Practical Life Builds Toilet Independence</h2>
      <ul class="space-y-3 list-disc pl-5">
        <li><strong>Child-Sized Infrastructure:</strong> Accessible low toilets and sinks allow toddlers to manage personal hygiene independently.</li>
        <li><strong>Peer Observation:</strong> In mixed-age classrooms, younger toddlers observe older classmates using the bathroom, inspiring natural confidence.</li>
        <li><strong>Positive & Respectful Language:</strong> Accidents are handled calmly as natural learning experiences without shame or pressure.</li>
      </ul>

      <!-- CTA -->
      <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200 text-center my-10 shadow-sm">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Visit Kubo Montessori Today</h3>
        <p class="text-slate-600 text-sm mb-6 max-w-lg mx-auto">
          Schedule a private tour to discuss your child's developmental journey with our director.
        </p>
        <a
          href="https://calendly.com/mary-kubo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-md transition-colors text-sm"
        >
          Schedule Your Tour Online
        </a>
      </div>

      <FAQSection
        title="Potty Training FAQ"
        subtitle="Frequently asked questions about toilet learning at Kubo Montessori."
        faqs={pottyFaqs}
      />
    </div>
  </article>

  <Footer />
</Layout>
