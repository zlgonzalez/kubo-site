---
import SEO from "../components/SEO.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  targetCity?: string;
}

const { title, description, image, article, targetCity } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      targetCity={targetCity}
    />

    <slot name="head" />

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async fetchpriority="low" src="https://www.googletagmanager.com/gtag/js?id=G-BE43SM2H4T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function() { dataLayer.push(arguments); };
      gtag("js", new Date());
      gtag("config", "G-BE43SM2H4T");
    </script>

    <!-- Client-side Calendly analytics conversion listener and deferred floating badge -->
    <script>
      import { initCalendlyAnalytics, scheduleCalendlyBadge } from "../utils/calendly-analytics";
      initCalendlyAnalytics();
      scheduleCalendlyBadge();
    </script>
  </head>
  <body class="font-sans text-gray-700 antialiased">
    <main>
      <slot />
    </main>
    <style is:global>
      /* Global styles if needed, though Tailwind covers most */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Playfair Display", serif;
      }
      body {
        font-family: "Lato", sans-serif;
      }
    </style>
  </body>
</html>
